<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Horyzont</vendor>
  <action id="org.horyzont.update-agent">
    <description>Manage updates (Horyzont Updates)</description>
    <description xml:lang="pl">Zarządzanie aktualizacjami (Horyzont Updates)</description>
    <message>Authentication is required to change update settings or install Horyzont updates</message>
    <message xml:lang="pl">Zmiana ustawień aktualizacji lub instalacja aktualizacji Horyzontu wymaga uwierzytelnienia</message>
    <icon_name>system-software-update</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@AGENT@</annotate>
  </action>
</policyconfig>
